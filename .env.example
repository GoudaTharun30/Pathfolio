PORT=5000

# MongoDB Configuration
# MongoDB Atlas (Cloud Database - Recommended):
# Format: mongodb+srv://<username>:<password>@<cluster-host>/pathfolio?retryWrites=true&w=majority
# Important: If your database password contains special characters (like @, #, $, %, etc.), URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pathfolio?retryWrites=true&w=majority

# Local MongoDB (Alternative for offline local development):
# MONGODB_URI=mongodb://127.0.0.1:27017/pathfolio

# Authentication & Security
JWT_SECRET=pathfolio_super_secret_jwt_key_2026

# Clerk Authentication (Optional)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# AI Provider Configuration
# Options: gemini | openai | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

